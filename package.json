{
  "name": "snake-game",
  "version": "1.7.0",
  "description": "La viborita con desafíos matemáticos y cinco biomas",
  "author": "Ariel",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win dir",
    "dist": "node scripts/build.cjs",
    "dev": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:electron": "electron tests/electron-smoke.cjs"
  },
  "build": {
    "appId": "com.ariel.snakegame",
    "productName": "Viborita Matemática",
    "files": [
      "electron/**/*",
      "index.html",
      "script.js",
      "style.css",
      "assets/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "artifactName": "Viborita-Matematica-${version}-Windows.${ext}",
    "compression": "normal"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
