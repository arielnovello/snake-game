{
  "name": "snake-game",
  "version": "1.0.0",
  "description": "La viborita con desafíos matemáticos y cinco biomas",
  "author": "Ariel",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win dir",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.ariel.snakegame",
    "productName": "Snake Game",
    "files": [
      "electron/**/*",
      "index.html",
      "script.js",
      "style.css",
      "assets/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "artifactName": "Snake-Game-${version}-Windows.${ext}",
    "compression": "store"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
